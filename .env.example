# 서버 배포용 환경변수 예시. 서버에서 이 파일을 .env 로 복사한 뒤 값을 채운다 → README 7장.
#   cp .env.example .env && nano .env
# .env 는 .gitignore 에 들어 있어 git 에 올라가지 않는다. 실제 값은 절대 커밋하지 않는다.

# 랜덤 비밀번호 만들기: openssl rand -base64 24
# DB 비밀번호는 DB 볼륨을 처음 만들 때만 적용된다. 나중에 바꾸려면 README 7장 "비밀번호를 바꿀 때"를 본다.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# JWT 서명 키 (32바이트 이상): openssl rand -base64 48
JWT_SECRET=

# 앱이 처음 뜰 때 자동으로 만드는 관리자 계정. README 에 적힌 개발용 비밀번호를 쓰지 않는다
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=

# API 를 부를 프론트 주소. 여러 개면 쉼표로 (예: http://13.125.0.10:5173,https://shop.example.com)
CORS_ALLOWED_ORIGINS=

# local = 시연 데이터(판매자·상품·주문 300건) 포함 / prod = 빈 상태로 시작
SPRING_PROFILES_ACTIVE=local
